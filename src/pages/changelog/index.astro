---
import CallToAction from '../../components/CallToAction.astro';
import { SITE, trackedExternalUrl } from '../../data/site.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Neural Companion Changelog and Releases"
  description="Read Neural Companion release history and download current builds from the authoritative application repository."
>
  <header class="page-hero">
    <div class="container prose">
      <p class="eyebrow">Project updates</p>
      <h1>Changelog</h1>
      <p class="lede">Release history changes with the application. The public repository remains the authoritative source for shipped updates and downloadable builds.</p>
      <div class="page-actions">
        <CallToAction href={trackedExternalUrl(SITE.changelog, 'changelog')} label="Read the changelog" analyticsEvent="outbound_docs_click" analyticsLocation="changelog_hero" />
        <CallToAction href={trackedExternalUrl(SITE.releases, 'changelog_releases')} label="Browse releases" variant="secondary" analyticsEvent="release_click" analyticsLocation="changelog_hero" />
      </div>
    </div>
  </header>
</BaseLayout>
