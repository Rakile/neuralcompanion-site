---
interface Props {
  href: string;
  label: string;
  variant?: 'primary' | 'secondary';
  analyticsEvent?: string;
  analyticsLocation?: string;
}

const { href, label, variant = 'primary', analyticsEvent, analyticsLocation } = Astro.props;
const external = /^https?:\/\//.test(href);
---

<a class:list={['button', { 'button--secondary': variant === 'secondary' }]} href={href} rel={external ? 'noopener' : undefined} data-analytics-event={analyticsEvent} data-analytics-location={analyticsLocation}>
  {label}
</a>
