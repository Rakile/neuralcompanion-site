---
import { imageMedia } from '../data/media.ts';

const captures = [
  { src: '/images/product/native-runtime.webp', title: 'Native runtime workspace', copy: 'A clearer setup flow for language, speech, voice, visual reply, avatars, and session profiles.' },
  { src: '/images/product/native-conversation.webp', title: 'Native conversation workspace', copy: 'Conversation, runtime controls, and session feedback share one focused desktop workspace.' },
  { src: '/images/product/native-addons.webp', title: 'Native addon manager', copy: 'Browse and configure the modular addon system through the new native interface.' },
] as const;
---

<section class="product-gallery-section" aria-labelledby="gallery-heading">
  <div class="container">
    <div class="release-preview" role="note">
      <span class="release-preview__status">In development</span>
      <p><strong>A major native UI update is on the way.</strong> Here is an early look at the new Neural Companion workspace while development continues.</p>
    </div>
    <div class="section-heading">
      <div><p class="eyebrow">Native interface preview · Real application captures</p><h2 id="gallery-heading">A first look at what is coming</h2></div>
      <p class="section-intro">These are real captures from the native-QML development build. The interface may continue to evolve before release.</p>
    </div>
    <div class="product-gallery">
      {captures.map((capture, index) => (
        <figure class:list={['product-gallery__item', { 'product-gallery__item--wide': index === 0 }]}>
          <a href={capture.src} aria-label={`Open full-size ${capture.title} screenshot`} data-gallery-open data-analytics-event="screenshot_gallery_open" data-analytics-location="homepage_gallery">
            <img src={capture.src} alt={`${capture.title} in Neural Companion`} width={imageMedia(capture.src).width} height={imageMedia(capture.src).height} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
          </a>
          <figcaption><strong>{capture.title}</strong><span>{capture.copy}</span></figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
